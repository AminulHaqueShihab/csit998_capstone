\contentsline {figure}{\numberline {1}{\ignorespaces The experimental pipeline, from raw archives to the frozen test evaluation.}}{7}{figure.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces BTCUSDT daily close over the study period. Shading marks the validation and test periods.}}{10}{figure.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces Monthly retained headline volume and average VADER score. The dashed line marks the start of the second export, and the shaded block is the 17-day gap.}}{12}{figure.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Ensemble test accuracy of the main and secondary models. The dashed line is 50\%, although the actual majority baseline reaches 51.50\%.}}{21}{figure.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Predictions against outcomes on the 334 test days. (a) Actual close, with right and wrong calls of LSTM A. (b) Trailing 7-day share of up days against the 7-day average predicted probability of a rise. (c) Trailing 30-day accuracy of each model.}}{22}{figure.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Confusion matrices of the majority baseline and the two primary LSTM ensembles. Rows are the actual class and columns the predicted class.}}{23}{figure.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Ensemble accuracy on validation and test days, from the saved evaluation files.}}{24}{figure.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Distribution of ensemble probabilities on the test days. Most lie close to the 0.5 threshold.}}{25}{figure.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces Walk-forward predictions over time, 2023 to 2026. (a) Rolling 90-day accuracy. (b) Share of days each model called a rise, against the share of days that actually rose. Dotted lines mark the start of each period.}}{27}{figure.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Ensemble accuracy of each model in the eight walk-forward periods. The dotted line is 50\%.}}{28}{figure.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Spearman correlation between day-$t$ sentiment and the return on day $t+k$. An asterisk marks a nominal $p<0.05$, and bold type marks significance after correction for 132 tests.}}{28}{figure.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces Monthly test accuracy of the two LSTM ensembles. Each month has 28 to 31 days, so single-month differences carry little weight.}}{29}{figure.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces Ensemble accuracy at the three prediction horizons. These tasks were not pre-specified and are not directly comparable with the primary result.}}{31}{figure.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces The demonstration interface, showing LSTM A on the frozen test period.}}{34}{figure.14}%
